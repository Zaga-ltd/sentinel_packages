{
  "name": "@sentrinel/plugin",
  "version": "0.3.0",
  "description": "Sentrinel monitoring plugin \u2014 exact metrics, request logs, error tracking, distributed tracing, and structured logging for Elysia, Express, Next.js, Bun, and Flutter.",
  "license": "MIT",
  "author": "Zaga Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zaga-ltd/sentinel_packages.git"
  },
  "homepage": "https://github.com/Zaga-ltd/sentinel_packages#readme",
  "keywords": [
    "elysia",
    "express",
    "nextjs",
    "bun",
    "monitoring",
    "apm",
    "metrics",
    "observability",
    "request-logging",
    "distributed-tracing",
    "error-tracking"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./elysia": {
      "types": "./dist/types/elysia.d.ts",
      "bun": "./src/elysia.ts",
      "import": "./dist/elysia.js",
      "require": "./dist/cjs/elysia.js"
    },
    "./express": {
      "types": "./dist/types/express.d.ts",
      "bun": "./src/express.ts",
      "import": "./dist/express.js",
      "require": "./dist/cjs/express.js"
    },
    "./next": {
      "types": "./dist/types/next.d.ts",
      "bun": "./src/next.ts",
      "import": "./dist/next.js",
      "require": "./dist/cjs/next.js"
    },
    "./next/middleware": {
      "types": "./dist/types/next-middleware.d.ts",
      "bun": "./src/next-middleware.ts",
      "import": "./dist/next-middleware.js",
      "require": "./dist/cjs/next-middleware.js"
    },
    "./bun": {
      "types": "./dist/types/bun.d.ts",
      "bun": "./src/bun.ts",
      "import": "./dist/bun.js",
      "require": "./dist/cjs/bun.js"
    },
    "./browser": {
      "types": "./dist/types/browser.d.ts",
      "bun": "./src/browser.ts",
      "import": "./dist/browser.js",
      "require": "./dist/cjs/browser.js"
    },
    "./tunnel": {
      "types": "./dist/types/tunnel.d.ts",
      "bun": "./src/tunnel.ts",
      "import": "./dist/tunnel.js",
      "require": "./dist/cjs/tunnel.js"
    },
    "./flutter": {
      "types": "./dist/types/flutter.d.ts",
      "bun": "./src/flutter.ts",
      "import": "./dist/flutter.js",
      "require": "./dist/cjs/flutter.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts"
  },
  "peerDependencies": {
    "elysia": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "elysia": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "dotenv": "^8.2.0",
    "elysia": "^1.2.0",
    "node-fetch": "^3.3.2",
    "rrweb": "2.1.1"
  },
  "workspaces": [
    "mcp"
  ]
}
