{
  "name": "@sentrinel/plugin",
  "version": "0.2.0",
  "description": "Sentrinel monitoring plugin \u2014 exact metrics, request logs, error tracking, distributed tracing, and structured logging for Elysia, Express, Next.js, Bun, and Flutter.",
  "license": "MIT",
  "author": "Zaga Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zaga-ltd/sentinel_packages.git"
  },
  "homepage": "https://github.com/Zaga-ltd/sentinel_packages#readme",
  "keywords": [
    "elysia",
    "express",
    "nextjs",
    "bun",
    "monitoring",
    "apm",
    "metrics",
    "observability",
    "request-logging",
    "distributed-tracing",
    "error-tracking"
  ],
